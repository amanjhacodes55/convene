{
  "name": "convene-desktop",
  "productName": "Convene",
  "version": "1.0.0",
  "private": true,
  "description": "Convene video meetings as a desktop app for macOS, Windows and Linux.",
  "homepage": "https://convene-meet.netlify.app",
  "license": "MIT",
  "author": {
    "name": "Convene",
    "email": "amanjhacodes55@users.noreply.github.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "smoke": "node smoke.mjs"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "playwright-core": "1.64.1"
  },
  "build": {
    "appId": "org.convene.desktop",
    "productName": "Convene",
    "copyright": "Convene contributors, MIT License",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": ["main.js", "picker.html", "picker-preload.js", "offline.html", "build/icon.png"],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "artifactName": "Convene-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Convene uses your camera so others in the meeting can see you.",
        "NSMicrophoneUsageDescription": "Convene uses your microphone so others in the meeting can hear you.",
        "NSScreenCaptureUsageDescription": "Convene shares your screen when you choose to present."
      }
    },
    "dmg": {
      "title": "Convene"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "Convene-windows-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Convene"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "artifactName": "Convene-linux.${ext}",
      "executableName": "convene",
      "category": "Network;VideoConference",
      "maintainer": "Convene <amanjhacodes55@users.noreply.github.com>",
      "synopsis": "Video meetings in a window of their own"
    }
  }
}
