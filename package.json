{
  "name": "convene",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source video meetings in the browser: HD video, screen sharing, chat, captions, waiting rooms and local recording, plus a developer platform with a REST API, OAuth 2.0 apps and signed webhooks. Runs on Netlify with no media server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amanjhacodes55/convene.git"
  },
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/call.mjs && node tests/e2e/platform.mjs && node tests/e2e/controls.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.0",
    "@netlify/blobs": "^11.1.6",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
